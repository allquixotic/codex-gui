+    /// Mutate only input still held by the active turn, before its consumer takes it.
+    #[expect(
+        clippy::await_holding_invalid_type,
+        reason = "active turn and pending input must be checked atomically"
+    )]
+    pub(crate) async fn update_pending_user_input(
+        &self,
+        active_turn: &Mutex<Option<ActiveTurn>>,
+        client_id: &str,
+        replacement: Option<Vec<UserInput>>,
+    ) -> Option<Vec<UserInput>> {
+        let active = active_turn.lock().await;
+        let active = active.as_ref()?;
+        let mut state = active.turn_state.lock().await;
+        let position = state.pending_input.items.iter().position(|input|
+            matches!(input, TurnInput::UserInput { client_id: Some(id), .. } if id == client_id)
+        )?;
+        if let Some(replacement) = replacement {
+            let TurnInput::UserInput { content, .. } = &mut state.pending_input.items[position]
+            else {
+                return None;
+            };
+            *content = replacement.clone();
+            Some(replacement)
+        } else {
+            let TurnInput::UserInput { content, .. } = state.pending_input.items.remove(position)
+            else {
+                return None;
+            };
+            Some(content)
+        }
     }
 
